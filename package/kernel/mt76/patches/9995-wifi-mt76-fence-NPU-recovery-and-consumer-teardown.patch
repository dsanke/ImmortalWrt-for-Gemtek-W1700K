From: OpenAI Codex <codex@openai.com>
Subject: [PATCH] wifi: mt76: fence NPU recovery and consumer teardown

Port the PR NPU recovery and teardown changes to mt76 be5ce791.
Retain only the required NPU lifecycle, DMA ownership, NAPI registration,
and reboot prerequisites from the former downstream patch stack.

Serialize RRO publication and deletion with consumer quiesce. Replay NPU
reserved memory and RRO addresses after a complete stop handshake. Keep
failed resets stopped, use provider-fenced queue access, and prevent DMA
release when the terminal fence fails.

Track NAPI transitions and IRQ tasklet state through reset, bootstrap MCU
responses while data producers remain stopped, and drain poll tails before
masking interrupts. Release IRQs before vectors and use a device link to
keep the secondary PCI function bound while the primary uses it.

Keep current upstream RX-NAPI teardown for untracked mt76 drivers: only
MT7996 opts into the serialized lifecycle. Other drivers already disable
RX NAPI in their remove paths, so disabling it again would hang removal.

Original changes by Yanghan Ye and OpenAI Codex.

Signed-off-by: OpenAI Codex <codex@openai.com>
---
diff --git a/dma.c b/dma.c
index a67880a..1da8f57 100644
--- a/dma.c
+++ b/dma.c
@@ -825,6 +825,85 @@ int mt76_dma_rx_fill(struct mt76_dev *dev, struct mt76_queue *q,
 	return frames;
 }
 
+struct mt76_dma_allocation {
+	struct list_head list;
+	struct device *dma_dev;
+	void *vaddr;
+	dma_addr_t dma_addr;
+	size_t size;
+};
+
+static void mt76_dma_free_coherent(void *data)
+{
+	struct mt76_dma_allocation *allocation = data;
+
+	dma_free_coherent(allocation->dma_dev, allocation->size,
+			  allocation->vaddr, allocation->dma_addr);
+	put_device(allocation->dma_dev);
+	kfree(allocation);
+}
+
+void *mt76_dma_alloc_coherent(struct mt76_dev *dev, size_t size,
+			      dma_addr_t *dma_handle, gfp_t gfp)
+{
+	struct mt76_dma_allocation *allocation;
+	int err;
+
+	if (dev->dma_dev == dev->dev)
+		return dmam_alloc_coherent(dev->dma_dev, size, dma_handle, gfp);
+
+	allocation = kmalloc(sizeof(*allocation), gfp);
+	if (!allocation)
+		return NULL;
+
+	allocation->dma_dev = get_device(dev->dma_dev);
+	allocation->size = size;
+	allocation->vaddr = dma_alloc_coherent(allocation->dma_dev, size,
+					       &allocation->dma_addr, gfp);
+	if (!allocation->vaddr) {
+		put_device(allocation->dma_dev);
+		kfree(allocation);
+		return NULL;
+	}
+
+	mutex_lock(&dev->dma_alloc_mutex);
+	if (dev->dma_alloc_quarantined) {
+		mutex_unlock(&dev->dma_alloc_mutex);
+		mt76_dma_free_coherent(allocation);
+		return NULL;
+	}
+
+	err = devm_add_action_or_reset(dev->dev, mt76_dma_free_coherent,
+				       allocation);
+	if (!err)
+		list_add_tail(&allocation->list, &dev->dma_allocations);
+	mutex_unlock(&dev->dma_alloc_mutex);
+	if (err)
+		return NULL;
+
+	*dma_handle = allocation->dma_addr;
+
+	return allocation->vaddr;
+}
+EXPORT_SYMBOL_GPL(mt76_dma_alloc_coherent);
+
+void mt76_dma_quarantine_allocations(struct mt76_dev *dev)
+{
+	struct mt76_dma_allocation *allocation, *tmp;
+	LIST_HEAD(list);
+
+	mutex_lock(&dev->dma_alloc_mutex);
+	dev->dma_alloc_quarantined = true;
+	list_splice_init(&dev->dma_allocations, &list);
+	mutex_unlock(&dev->dma_alloc_mutex);
+
+	list_for_each_entry_safe(allocation, tmp, &list, list) {
+		devm_remove_action(dev->dev, mt76_dma_free_coherent, allocation);
+		list_del_init(&allocation->list);
+	}
+}
+EXPORT_SYMBOL_GPL(mt76_dma_quarantine_allocations);
+
 static int
 mt76_dma_alloc_queue(struct mt76_dev *dev, struct mt76_queue *q,
 		     int idx, int n_desc, int bufsize,
@@ -850,8 +929,8 @@ mt76_dma_alloc_queue(struct mt76_dev *dev, struct mt76_queue *q,
 	else
 		size = sizeof(struct mt76_desc);
 
-	q->desc = dmam_alloc_coherent(dev->dma_dev, q->ndesc * size,
-				      &q->desc_dma, GFP_KERNEL);
+	q->desc = mt76_dma_alloc_coherent(dev, q->ndesc * size,
+					  &q->desc_dma, GFP_KERNEL);
 	if (!q->desc)
 		return -ENOMEM;
 
@@ -1127,9 +1206,12 @@ static void
 mt76_dma_rx_queue_init(struct mt76_dev *dev, enum mt76_rxq_id qid,
 		       int (*poll)(struct napi_struct *napi, int budget))
 {
+	struct mt76_queue *q = &dev->q_rx[qid];
+
 	netif_napi_add(dev->napi_dev, &dev->napi[qid], poll);
-	mt76_dma_rx_fill_buf(dev, &dev->q_rx[qid], false);
-	napi_enable(&dev->napi[qid]);
+	set_bit(qid, &dev->napi_registered);
+	mt76_dma_rx_fill_buf(dev, q, false);
+	mt76_napi_enable(dev, qid, &dev->napi[qid]);
 }
 
 static int
@@ -1152,6 +1234,7 @@ mt76_dma_init(struct mt76_dev *dev,
 	dev->tx_napi_dev = alloc_netdev_dummy(sizeof(struct mt76_dev *));
 	if (!dev->tx_napi_dev) {
 		free_netdev(dev->napi_dev);
+		dev->napi_dev = NULL;
 		return -ENOMEM;
 	}
 	priv = netdev_priv(dev->tx_napi_dev);
@@ -1197,8 +1280,13 @@ void mt76_dma_cleanup(struct mt76_dev *dev)
 	int i;
 
 	mt76_worker_disable(&dev->tx_worker);
-	napi_disable(&dev->tx_napi);
-	netif_napi_del(&dev->tx_napi);
+	if (dev->tx_napi_dev &&
+	    (!dev->napi_state_tracked ||
+	     test_bit(MT76_NAPI_TX, &dev->napi_registered))) {
+		mt76_napi_disable(dev, MT76_NAPI_TX, &dev->tx_napi);
+		netif_napi_del(&dev->tx_napi);
+		clear_bit(MT76_NAPI_TX, &dev->napi_registered);
+	}
 
 	for (i = 0; i < ARRAY_SIZE(dev->phys); i++) {
 		struct mt76_phy *phy = dev->phys[i];
@@ -1214,13 +1302,25 @@ void mt76_dma_cleanup(struct mt76_dev *dev)
 	for (i = 0; i < ARRAY_SIZE(dev->q_mcu); i++)
 		mt76_dma_tx_cleanup(dev, dev->q_mcu[i], true);
 
-	mt76_for_each_q_rx(dev, i) {
+	for (i = 0; i < ARRAY_SIZE(dev->q_rx); i++) {
 		struct mt76_queue *q = &dev->q_rx[i];
+		bool napi_registered = test_bit(i, &dev->napi_registered);
 
-		netif_napi_del(&dev->napi[i]);
-		mt76_dma_rx_cleanup(dev, q);
+		/* Untracked drivers disable RX NAPI in their own remove path. */
+		if (napi_registered && dev->napi_state_tracked)
+			mt76_napi_disable(dev, i, &dev->napi[i]);
+		if (q->ndesc)
+			mt76_dma_rx_cleanup(dev, q);
+
+		if (q->page_pool) {
+			page_pool_destroy(q->page_pool);
+			q->page_pool = NULL;
+		}
 
-		page_pool_destroy(q->page_pool);
+		if (napi_registered) {
+			netif_napi_del(&dev->napi[i]);
+			clear_bit(i, &dev->napi_registered);
+		}
 	}
 
 	if (mtk_wed_device_active(&dev->mmio.wed))
@@ -1231,7 +1331,13 @@ void mt76_dma_cleanup(struct mt76_dev *dev)
 
 	mt76_free_pending_txwi(dev);
 	mt76_free_pending_rxwi(dev);
-	free_netdev(dev->napi_dev);
-	free_netdev(dev->tx_napi_dev);
+	if (dev->napi_dev) {
+		free_netdev(dev->napi_dev);
+		dev->napi_dev = NULL;
+	}
+	if (dev->tx_napi_dev) {
+		free_netdev(dev->tx_napi_dev);
+		dev->tx_napi_dev = NULL;
+	}
 }
 EXPORT_SYMBOL_GPL(mt76_dma_cleanup);
