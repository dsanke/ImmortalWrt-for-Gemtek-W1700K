+void mt76_npu_rx_queues_deinit(struct mt76_dev *dev)
+{
+	struct airoha_npu *npu;
+	int i;
+
+	mutex_lock(&dev->mutex);
+	npu = rcu_dereference_protected(dev->mmio.npu,
+					lockdep_is_held(&dev->mutex));
+
+	for (i = MT_RXQ_NPU0; i <= MT_RXQ_NPU1; i++) {
+		struct mt76_queue *q = &dev->q_rx[i];
+		bool irq_registered, napi_registered;
+		int index = i - MT_RXQ_NPU0;
+		u32 status;
+
+		irq_registered = READ_ONCE(q->npu_irq_registered);
+		napi_registered = test_bit(i, &dev->napi_registered);
+		if (irq_registered) {
+			WRITE_ONCE(q->npu_irq_registered, false);
+			if (npu) {
+				rcu_read_lock();
+				status = airoha_npu_wlan_get_irq_status(npu, index);
+				airoha_npu_wlan_set_irq_status(npu, status);
+				airoha_npu_wlan_disable_irq(npu, index);
+				rcu_read_unlock();
+			}
+
+			devm_free_irq(dev->dev, q->npu_irq, q);
+			q->npu_irq = -1;
+		}
+
+		if (napi_registered) {
+			mt76_napi_disable(dev, i, &dev->napi[i]);
+		}
+
+		/* A poll already completing can race the first IRQ mask. */
+		if (npu && (irq_registered || napi_registered)) {
+			rcu_read_lock();
+			status = airoha_npu_wlan_get_irq_status(npu, index);
+			airoha_npu_wlan_set_irq_status(npu, status);
+			airoha_npu_wlan_disable_irq(npu, index);
+			rcu_read_unlock();
+		}
+
+		if (q->page_pool) {
+			mt76_npu_queue_cleanup(dev, q);
+			page_pool_destroy(q->page_pool);
+			q->page_pool = NULL;
+		}
+		if (napi_registered) {
+			netif_napi_del(&dev->napi[i]);
+			clear_bit(i, &dev->napi_registered);
+		}
+		q->ndesc = 0;
+	}
+	mutex_unlock(&dev->mutex);
+}
+EXPORT_SYMBOL_GPL(mt76_npu_rx_queues_deinit);
