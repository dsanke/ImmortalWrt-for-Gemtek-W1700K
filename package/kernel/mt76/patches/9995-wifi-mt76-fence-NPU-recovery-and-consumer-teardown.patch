+	mutex_lock(&dev->npu_stop_mutex);
+	if (READ_ONCE(dev->terminal))
+		goto unlock;
+	napi_restore = dev->napi_restore;
+
+	for (i = 0; i < __MT_RXQ_MAX; i++) {
+		if (!test_bit(i, &napi_restore) ||
+		    !test_bit(i, &dev->mt76.napi_registered))
+			continue;
+
+		mt76_napi_enable(&dev->mt76, i, &dev->mt76.napi[i]);
+		local_bh_disable();
+		napi_schedule(&dev->mt76.napi[i]);
+		local_bh_enable();
+	}
+	if (test_bit(MT76_NAPI_TX, &napi_restore) &&
+	    test_bit(MT76_NAPI_TX, &dev->mt76.napi_registered)) {
+		mt76_napi_enable(&dev->mt76, MT76_NAPI_TX,
+				 &dev->mt76.tx_napi);
+		local_bh_disable();
+		napi_schedule(&dev->mt76.tx_napi);
+		local_bh_enable();
+	}
