+	for (i = 0; i < __MT_RXQ_MAX; i++) {
+		if (test_bit(i, &dev->mt76.napi_registered))
+			mt76_napi_disable(&dev->mt76, i, &dev->mt76.napi[i]);
+	}
+	if (test_bit(MT76_NAPI_TX, &dev->mt76.napi_registered))
