From: OpenAI Codex <codex@openai.com>
Subject: [PATCH] dt-bindings: net: airoha: describe NPU reset and memory layouts

Require the top-level NPU reset for EN7581 and AN7583. Describe the
firmware image pair and supported one-, two-, four- and six-region
layouts, pairing region counts with names. The mailbox pool is optional.

Combines the original PR binding and layout-pairing fixes.

Signed-off-by: OpenAI Codex <codex@openai.com>
---

--- a/Documentation/devicetree/bindings/net/airoha,en7581-npu.yaml
+++ b/Documentation/devicetree/bindings/net/airoha,en7581-npu.yaml
@@ -4,7 +4,7 @@
 $id: http://devicetree.org/schemas/net/airoha,en7581-npu.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: Airoha Network Processor Unit for EN7581 SoC
+title: Airoha Network Processor Unit for EN7581 and AN7583 SoCs
 
 maintainers:
   - Lorenzo Bianconi <lorenzo@kernel.org>
@@ -18,9 +18,16 @@
   compatible:
     enum:
       - airoha,en7581-npu
+      - airoha,an7583-npu
 
   reg:
     maxItems: 1
+
+  resets:
+    maxItems: 1
+
+  reset-names:
+    const: npu
 
   interrupts:
     items:
@@ -40,28 +47,107 @@
       - description: wlan irq line4
       - description: wlan irq line5
 
+  firmware-name:
+    minItems: 2
+    maxItems: 2
+    items:
+      - description: NPU RV32 firmware image
+      - description: NPU data firmware image
+
   memory-region:
     oneOf:
-      - items:
+      - minItems: 1
+        maxItems: 1
+        items:
           - description: NPU firmware binary region
-      - items:
+      - minItems: 2
+        maxItems: 2
+        items:
+          - description: NPU firmware binary region
+          - description: NPU mailbox DMA region
+      - minItems: 4
+        maxItems: 4
+        items:
           - description: NPU firmware binary region
           - description: NPU wlan offload RX buffers region
           - description: NPU wlan offload TX buffers region
           - description: NPU wlan offload TX packet identifiers region
+      - minItems: 6
+        maxItems: 6
+        items:
+          - description: NPU firmware binary region
+          - description: NPU wlan offload RX buffers region
+          - description: NPU wlan offload TX buffers region
+          - description: NPU wlan offload TX packet identifiers region
+          - description: NPU block-ack state region
+          - description: NPU mailbox DMA region
 
   memory-region-names:
-    items:
-      - const: firmware
-      - const: pkt
-      - const: tx-pkt
-      - const: tx-bufid
+    oneOf:
+      - minItems: 1
+        maxItems: 1
+        items:
+          - enum: [ firmware, binary ]
+      - minItems: 2
+        maxItems: 2
+        items:
+          - const: binary
+          - const: mbox
+      - minItems: 4
+        maxItems: 4
+        items:
+          - enum: [ firmware, binary ]
+          - const: pkt
+          - const: tx-pkt
+          - const: tx-bufid
+      - minItems: 6
+        maxItems: 6
+        items:
+          - const: binary
+          - const: pkt
+          - const: tx-pkt
+          - const: tx-bufid
+          - const: ba
+          - const: mbox
+
+oneOf:
+  - properties:
+      memory-region:
+        minItems: 1
+        maxItems: 1
+      memory-region-names:
+        minItems: 1
+        maxItems: 1
+  - properties:
+      memory-region:
+        minItems: 2
+        maxItems: 2
+      memory-region-names:
+        minItems: 2
+        maxItems: 2
+  - properties:
+      memory-region:
+        minItems: 4
+        maxItems: 4
+      memory-region-names:
+        minItems: 4
+        maxItems: 4
+  - properties:
+      memory-region:
+        minItems: 6
+        maxItems: 6
+      memory-region-names:
+        minItems: 6
+        maxItems: 6
 
 required:
   - compatible
   - reg
+  - resets
+  - reset-names
   - interrupts
   - memory-region
+  - memory-region-names
 
 additionalProperties: false
 
@@ -69,6 +155,7 @@
   - |
     #include <dt-bindings/interrupt-controller/arm-gic.h>
     #include <dt-bindings/interrupt-controller/irq.h>
+    #include <dt-bindings/reset/airoha,en7581-reset.h>
     soc {
       #address-cells = <2>;
       #size-cells = <2>;
@@ -76,6 +163,8 @@
       npu@1e900000 {
         compatible = "airoha,en7581-npu";
         reg = <0 0x1e900000 0 0x313000>;
+        resets = <&scuclk EN7581_NPU_RST>;
+        reset-names = "npu";
         interrupts = <GIC_SPI 125 IRQ_TYPE_LEVEL_HIGH>,
                      <GIC_SPI 103 IRQ_TYPE_LEVEL_HIGH>,
                      <GIC_SPI 109 IRQ_TYPE_LEVEL_HIGH>,
