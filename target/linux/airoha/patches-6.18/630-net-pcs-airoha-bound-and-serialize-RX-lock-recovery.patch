+static void airoha_pcs_an_restart(struct phylink_pcs *pcs)
+{
+	struct airoha_pcs_port *port = to_airoha_pcs_port(pcs);
+	struct airoha_pcs_rxlock_recovery *recovery;
+
+	if (!port->priv->data->rxlock_workaround) {
+		__airoha_pcs_an_restart(port);
 		return;
 	}
+
+	recovery = &port->rxlock;
+	mutex_lock(&recovery->lock);
+	if (recovery->state == AIROHA_PCS_RXLOCK_RECONFIGURING)
+		recovery->an_restart_pending = true;
+	else if (recovery->state != AIROHA_PCS_RXLOCK_CONFIG_FAILED)
+		__airoha_pcs_an_restart(port);
+	mutex_unlock(&recovery->lock);
 }
 
