+static int airoha_pcs_config(struct phylink_pcs *pcs, unsigned int neg_mode,
+			     phy_interface_t interface,
+			     const unsigned long *advertising,
+			     bool permit_pause_to_mac)
 {
 	struct airoha_pcs_port *port = to_airoha_pcs_port(pcs);
+	const struct airoha_pcs_match_data *data = port->priv->data;
+	struct airoha_pcs_rxlock_recovery *recovery = &port->rxlock;
+	bool major_config, restart_pending = false;
+	int ret;
+
+	if (!data->rxlock_workaround)
+		return __airoha_pcs_config(pcs, neg_mode, interface, advertising,
+					   permit_pause_to_mac);
+
+	mutex_lock(&recovery->lock);
+	major_config = recovery->config_pending;
+	if (!major_config) {
+		recovery->state = AIROHA_PCS_RXLOCK_RECONFIGURING;
+		recovery->deadline = 0;
+		recovery->signal_loss_deadline = 0;
+		recovery->attempts = 0;
+		recovery->signal_loss_pending = false;
+		recovery->signal_lost = false;
+		recovery->pcs_config_done = false;
+		recovery->pcs_config_restart = false;
+		recovery->post_config_done = false;
+		recovery->an_restart_pending = false;
+	}
+
+	ret = __airoha_pcs_config(pcs, neg_mode, interface, advertising,
+				  permit_pause_to_mac);
+	if (ret < 0) {
+		recovery->state = AIROHA_PCS_RXLOCK_CONFIG_FAILED;
+		recovery->deadline = 0;
+		recovery->config_pending = false;
+		recovery->pcs_config_done = false;
+		recovery->pcs_config_restart = false;
+		recovery->post_config_done = false;
+		recovery->an_restart_pending = false;
+	} else if (major_config) {
+		recovery->pcs_config_done = true;
+		recovery->pcs_config_restart = ret > 0;
+		if (recovery->post_config_done) {
+			/* A positive return makes phylink restart AN after this
+			 * callback, which also satisfies a queued restart request.
+			 */
+			restart_pending = recovery->an_restart_pending &&
+					  !recovery->pcs_config_restart;
+			airoha_pcs_rxlock_rearm(recovery);
+		}
+	} else {
+		airoha_pcs_rxlock_rearm(recovery);
+	}
+	if (restart_pending)
+		__airoha_pcs_an_restart(port);
+	mutex_unlock(&recovery->lock);
+
+	return ret;
+}
