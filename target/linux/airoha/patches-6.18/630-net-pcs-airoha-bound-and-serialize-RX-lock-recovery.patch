+enum airoha_pcs_rxlock_state {
+	AIROHA_PCS_RXLOCK_IDLE,
+	AIROHA_PCS_RXLOCK_RECONFIGURING,
+	AIROHA_PCS_RXLOCK_CONFIG_FAILED,
+	AIROHA_PCS_RXLOCK_OBSERVE,
+	AIROHA_PCS_RXLOCK_RESETTING,
+	AIROHA_PCS_RXLOCK_SETTLING,
+	AIROHA_PCS_RXLOCK_AN_WAIT,
+	AIROHA_PCS_RXLOCK_EXHAUSTED,
+};
+
+struct airoha_pcs_rxlock_recovery {
+	/* Serializes state transitions and CDR resets. */
+	struct mutex lock;
+	enum airoha_pcs_rxlock_state state;
+	unsigned long deadline;
+	unsigned long signal_loss_deadline;
+	u8 attempts;
+	bool signal_loss_pending;
+	bool signal_lost;
+	/* Keep recovery gated until both major-config callbacks complete. */
+	bool config_pending;
+	bool pcs_config_done;
+	bool pcs_config_restart;
+	bool post_config_done;
+	bool an_restart_pending;
+};
+
+static inline void
+airoha_pcs_rxlock_rearm(struct airoha_pcs_rxlock_recovery *recovery)
+{
+	recovery->state = AIROHA_PCS_RXLOCK_IDLE;
+	recovery->deadline = 0;
+	recovery->signal_loss_deadline = 0;
+	recovery->attempts = 0;
+	recovery->signal_loss_pending = false;
+	recovery->signal_lost = false;
+	recovery->config_pending = false;
+	recovery->pcs_config_done = false;
+	recovery->pcs_config_restart = false;
+	recovery->post_config_done = false;
+	recovery->an_restart_pending = false;
+}
