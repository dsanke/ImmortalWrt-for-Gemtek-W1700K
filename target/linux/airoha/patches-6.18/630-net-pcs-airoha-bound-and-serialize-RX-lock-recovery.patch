+int an7581_pcs_rxlock_workaround(struct airoha_pcs_priv *priv, int index,
+				 bool link, bool an_complete)
+{
+	struct airoha_pcs_rxlock_recovery *recovery =
+		&priv->ports[index].rxlock;
+	struct airoha_pcs_maps *maps = &priv->maps[index];
+	struct regmap *pcs_pma = priv->pcs_pma[index];
+	const char *action = NULL;
+	u32 base_r = 0, freqdet = 0, val = 0;
+	bool receiver_ready;
+	int ret, signal;
+
+	lockdep_assert_held(&recovery->lock);
+	if (recovery->state == AIROHA_PCS_RXLOCK_RECONFIGURING)
+		return -EAGAIN;
+	if (recovery->state == AIROHA_PCS_RXLOCK_CONFIG_FAILED)
+		return -EIO;
+
+	/* The in-band link bit describes the link reported by the partner. It
+	 * must not bypass the local receiver checks: the last AN word can remain
+	 * visible while the local CDR or Base-R block lock is lost.
 	 */
+	ret = regmap_read(maps->usxgmii_pcs,
+			  AIROHA_PCS_USXGMII_PCS_STUS_1, &val);
+	if (ret)
+		goto out;
+
+	receiver_ready = val & AIROHA_PCS_USXGMII_PCS_RX_LINK_STATUS_UP;
+	if (receiver_ready)
+		goto receiver_ready;
+
+	signal = an7581_pcs_have_rx_signal(priv, index);
+	if (signal < 0) {
+		ret = signal;
+		goto out;
+	}
+	if (!signal) {
+		if (recovery->signal_lost) {
+			action = "no-signal";
+		} else if (!recovery->signal_loss_pending) {
+			recovery->signal_loss_pending = true;
+			recovery->signal_loss_deadline =
+				jiffies + AN7581_PCS_RXLOCK_SIGNAL_LOSS;
+			action = "no-signal-observe";
+		} else if (time_before(jiffies,
+				       recovery->signal_loss_deadline)) {
+			action = "no-signal-observe";
+		} else {
+			airoha_pcs_rxlock_rearm(recovery);
+			recovery->signal_lost = true;
+			action = "no-signal-rearm";
+		}
+
+		an7581_pcs_report_rxlock(priv, index, val, false, false, action);
+		ret = -ENOLINK;
+		goto out;
+	}
+
+	/* A single no-signal sample does not end the current signal epoch. */
+	recovery->signal_loss_pending = false;
+	recovery->signal_loss_deadline = 0;
+	recovery->signal_lost = false;
+
+	ret = regmap_read(maps->usxgmii_pcs,
+			  AIROHA_PCS_USXGMII_BASE_R_10GB_T_PCS_STUS_1,
+			  &base_r);
+	if (ret)
+		goto out;
+
+	ret = regmap_read(pcs_pma, AIROHA_PCS_PMA_RX_FREQDET, &freqdet);
+	if (ret)
+		goto out;
+
+	receiver_ready = (freqdet & AIROHA_PCS_PMA_FBCK_LOCK) &&
+			 (base_r & AIROHA_PCS_USXGMII_PCS_BLK_LK);
+
+receiver_ready:
+	if (receiver_ready) {
+		recovery->signal_loss_pending = false;
+		recovery->signal_loss_deadline = 0;
+		recovery->signal_lost = false;
+		if (link) {
+			airoha_pcs_rxlock_rearm(recovery);
+			ret = 0;
+			goto out;
+		} else if (recovery->state != AIROHA_PCS_RXLOCK_EXHAUSTED) {
+			recovery->state = AIROHA_PCS_RXLOCK_AN_WAIT;
+			recovery->deadline = 0;
+		}
+
+		ret = 0;
+		goto out;
+	}
+
+	switch (recovery->state) {
+	case AIROHA_PCS_RXLOCK_IDLE:
+	case AIROHA_PCS_RXLOCK_AN_WAIT:
+		recovery->state = AIROHA_PCS_RXLOCK_OBSERVE;
+		recovery->deadline = jiffies + AN7581_PCS_RXLOCK_RETRY_DELAY;
+		action = an_complete ? "observe-an-complete" : "observe";
+		ret = -EAGAIN;
+		break;
+	case AIROHA_PCS_RXLOCK_OBSERVE:
+	case AIROHA_PCS_RXLOCK_SETTLING:
+		if (time_before(jiffies, recovery->deadline)) {
+			action = recovery->state == AIROHA_PCS_RXLOCK_OBSERVE ?
+				 "observe" : "settling";
+			ret = -EAGAIN;
+			break;
+		}
+
+		if (recovery->attempts >= AN7581_PCS_RXLOCK_MAX_ATTEMPTS) {
+			recovery->state = AIROHA_PCS_RXLOCK_EXHAUSTED;
+			recovery->deadline =
+				jiffies + AN7581_PCS_RXLOCK_COOLDOWN;
+			action = "cooldown";
+			ret = -ETIMEDOUT;
+			break;
+		}
+		goto reset;
+	case AIROHA_PCS_RXLOCK_RECONFIGURING:
+		action = "reconfiguring";
+		ret = -EAGAIN;
+		break;
+	case AIROHA_PCS_RXLOCK_CONFIG_FAILED:
+		action = "config-failed";
+		ret = -EIO;
+		break;
+	case AIROHA_PCS_RXLOCK_RESETTING:
+		action = "resetting";
+		ret = -EAGAIN;
+		break;
+	case AIROHA_PCS_RXLOCK_EXHAUSTED:
+		if (time_before(jiffies, recovery->deadline)) {
+			action = "cooldown";
+			ret = -ETIMEDOUT;
+			break;
+		}
+
+		recovery->attempts = 0;
+		recovery->state = AIROHA_PCS_RXLOCK_OBSERVE;
+		recovery->deadline =
+			jiffies + AN7581_PCS_RXLOCK_RETRY_DELAY;
+		action = "reobserve";
+		ret = -EAGAIN;
+		break;
+	default:
+		recovery->state = AIROHA_PCS_RXLOCK_EXHAUSTED;
+		recovery->attempts = AN7581_PCS_RXLOCK_MAX_ATTEMPTS;
+		recovery->deadline = jiffies + AN7581_PCS_RXLOCK_COOLDOWN;
+		action = "invalid-state";
+		ret = -EIO;
+		break;
+	}
+	goto report;
+
+reset:
+	recovery->state = AIROHA_PCS_RXLOCK_RESETTING;
+	recovery->attempts++;
+	priv->rxlock_reset_count[index]++;
+	an7581_pcs_report_rxlock(priv, index, val, true, true, "cdr-reset");
 	an7581_pcs_cdr_reset(priv, index, PHY_INTERFACE_MODE_NA, false);
-
-	/* Report there is an error with Link Detection and we
-	 * should test again later.
-	 */
-	return -EINVAL;
+	if (recovery->attempts >= AN7581_PCS_RXLOCK_MAX_ATTEMPTS) {
+		recovery->state = AIROHA_PCS_RXLOCK_EXHAUSTED;
+		recovery->deadline = jiffies + AN7581_PCS_RXLOCK_COOLDOWN;
+	} else {
+		recovery->state = AIROHA_PCS_RXLOCK_SETTLING;
+		recovery->deadline = jiffies + AN7581_PCS_RXLOCK_RETRY_DELAY;
+	}
+	ret = -EAGAIN;
+	goto out;
+
+report:
+	an7581_pcs_report_rxlock(priv, index, val, true, false, action);
+
+out:
+	return ret;
 }
