From: OpenAI Codex <codex@openai.com>
Subject: [PATCH] net: pcs: airoha: fix SGMII speed and Clause 37 restart

Select the 10M port mode for a forced 10M SGMII link instead of mixing a
100M port mode with the 10M clock and interface selectors.

Program Clause 37 advertisements for 1000BASE-X as well as SGMII. Report
advertisement and AN-enable register failures; ask phylink to restart
Clause 37 when either value changes or the PCS was newly initialized.
Use the original 1000BASE-X reset-and-restart pulse, serialized by the
recovery lock.

Keep initialization state per port and invalidate it in pre_config, so a
major reconfiguration still runs the current analog bringup, calibration
and FIR setup. Advertisement-only updates must not reset an established
link or erase the speed selected by link_up. When the interface and
negotiation mode stay unchanged, update only advertisement and pause.
Failed configurations remain uninitialized for the next retry.

Signed-off-by: OpenAI Codex <codex@openai.com>
---
--- a/drivers/net/pcs/airoha/pcs-airoha-common.c
+++ b/drivers/net/pcs/airoha/pcs-airoha-common.c
@@ -530,6 +530,42 @@
 	}
 }
 
+static int airoha_pcs_config_an(struct airoha_pcs_maps *maps,
+				phy_interface_t interface, unsigned int neg_mode,
+				const unsigned long *advertising)
+{
+	bool enable = neg_mode == PHYLINK_PCS_NEG_INBAND_ENABLED;
+	bool changed, restart = false;
+	int advertise, ret;
+
+	if (enable) {
+		advertise = phylink_mii_c22_pcs_encode_advertisement(interface,
+								 advertising);
+		if (advertise < 0)
+			return advertise;
+
+		ret = regmap_update_bits_check(maps->hsgmii_an,
+					       AIROHA_PCS_HSGMII_AN_SGMII_REG_AN_4,
+					       AIROHA_PCS_HSGMII_AN_SGMII_DEV_ABILITY,
+					       FIELD_PREP(AIROHA_PCS_HSGMII_AN_SGMII_DEV_ABILITY,
+							  advertise), &changed);
+		if (ret)
+			return ret;
+		restart = changed;
+	}
+
+	ret = regmap_update_bits_check(maps->hsgmii_an,
+				       AIROHA_PCS_HSGMII_AN_SGMII_REG_AN_0,
+				       AIROHA_PCS_HSGMII_AN_SGMII_RA_ENABLE,
+				       enable ? AIROHA_PCS_HSGMII_AN_SGMII_RA_ENABLE : 0,
+				       &changed);
+	if (ret)
+		return ret;
+
+	return interface == PHY_INTERFACE_MODE_1000BASEX && enable &&
+	       (restart || changed);
+}
+
 static int __airoha_pcs_config(struct phylink_pcs *pcs,
 			       unsigned int neg_mode,
 			       phy_interface_t interface,
@@ -541,25 +577,36 @@
 	const struct airoha_pcs_match_data *data;
 	struct airoha_pcs_maps *maps;
 	int index = port->index;
+	bool initialized, restart_an = false;
 	u32 rate_adapt;
 	int ret;
 
 	maps = &priv->maps[port->index];
-	port->interface = interface;
 	data = priv->data;
-
-	/* Apply Analog and Digital configuration for PCS */
-	if (data->bringup) {
-		ret = data->bringup(priv, index, interface);
-		if (ret)
-			return ret;
-	}
-
-	/* Set final configuration for various modes */
-	airoha_pcs_init(priv, index, interface);
-
-	/* Configure Interrupt for various modes */
-	airoha_pcs_interrupt_init(priv, index, interface);
+	initialized = port->initialized && port->interface == interface;
+	port->initialized = false;
+
+	if (!initialized) {
+		/* Reinitialize on a major configuration, never just because
+		 * phylink changed the advertisement on an established link.
+		 */
+		if (data->bringup) {
+			ret = data->bringup(priv, index, interface);
+			if (ret)
+				return ret;
+		}
+
+		airoha_pcs_init(priv, index, interface);
+		airoha_pcs_interrupt_init(priv, index, interface);
+		restart_an = interface == PHY_INTERFACE_MODE_1000BASEX &&
+			     neg_mode == PHYLINK_PCS_NEG_INBAND_ENABLED;
+	}
+
+	/* A live advertisement/pause update must preserve the speed and
+	 * rate adaptation already selected by pcs_link_up().
+	 */
+	if (initialized && port->neg_mode == neg_mode)
+		goto config_advertisement;
 
 	rate_adapt = AIROHA_PCS_HSGMII_RATE_ADAPT_RX_EN |
 		     AIROHA_PCS_HSGMII_RATE_ADAPT_TX_EN;
@@ -652,26 +699,6 @@
 					      an_timer >> 4));
 	}
 
-	/* Setup SGMII AN and advertisement in DEV_ABILITY */
-	if (interface == PHY_INTERFACE_MODE_SGMII) {
-		if (neg_mode == PHYLINK_PCS_NEG_INBAND_ENABLED) {
-			int advertise = phylink_mii_c22_pcs_encode_advertisement(interface,
-										 advertising);
-			if (advertise < 0)
-				return advertise;
-
-			regmap_update_bits(maps->hsgmii_an, AIROHA_PCS_HSGMII_AN_SGMII_REG_AN_4,
-					   AIROHA_PCS_HSGMII_AN_SGMII_DEV_ABILITY,
-					   FIELD_PREP(AIROHA_PCS_HSGMII_AN_SGMII_DEV_ABILITY,
-						      advertise));
-
-			regmap_set_bits(maps->hsgmii_an, AIROHA_PCS_HSGMII_AN_SGMII_REG_AN_0,
-					AIROHA_PCS_HSGMII_AN_SGMII_RA_ENABLE);
-		} else {
-			regmap_clear_bits(maps->hsgmii_an, AIROHA_PCS_HSGMII_AN_SGMII_REG_AN_0,
-					  AIROHA_PCS_HSGMII_AN_SGMII_RA_ENABLE);
-		}
-	}
 
 	if (interface == PHY_INTERFACE_MODE_2500BASEX) {
 		regmap_clear_bits(maps->hsgmii_an, AIROHA_PCS_HSGMII_AN_SGMII_REG_AN_0,
@@ -737,6 +764,16 @@
 				AIROHA_PCS_HSGMII_AN_SGMII_RESET_PHY);
 	}
 
+config_advertisement:
+	/* Setup Clause 37/SGMII AN and advertisement in DEV_ABILITY. */
+	if (interface == PHY_INTERFACE_MODE_SGMII ||
+	    interface == PHY_INTERFACE_MODE_1000BASEX) {
+		ret = airoha_pcs_config_an(maps, interface, neg_mode, advertising);
+		if (ret < 0)
+			return ret;
+		restart_an |= ret > 0;
+	}
+
 	/* Configure Flow Control on XFI */
 	regmap_update_bits(maps->pcs_mac, AIROHA_PCS_XFI_MAC_XFI_GIB_CFG,
 			   AIROHA_PCS_XFI_TX_FC_EN | AIROHA_PCS_XFI_RX_FC_EN,
@@ -744,7 +781,11 @@
 				AIROHA_PCS_XFI_TX_FC_EN | AIROHA_PCS_XFI_RX_FC_EN :
 				0);
 
-	return 0;
+	port->interface = interface;
+	port->neg_mode = neg_mode;
+	port->initialized = true;
+
+	return restart_an;
 }
 
 static void __airoha_pcs_an_restart(struct airoha_pcs_port *port);
@@ -819,12 +860,22 @@
 
 	switch (port->interface) {
 	case PHY_INTERFACE_MODE_SGMII:
-	case PHY_INTERFACE_MODE_1000BASEX:
 	case PHY_INTERFACE_MODE_2500BASEX:
 		regmap_set_bits(maps->hsgmii_an, AIROHA_PCS_HSGMII_AN_SGMII_REG_AN_0,
 				AIROHA_PCS_HSGMII_AN_SGMII_AN_RESTART);
 		udelay(3);
 		regmap_clear_bits(maps->hsgmii_an, AIROHA_PCS_HSGMII_AN_SGMII_REG_AN_0,
+				  AIROHA_PCS_HSGMII_AN_SGMII_AN_RESTART);
+		break;
+	case PHY_INTERFACE_MODE_1000BASEX:
+		regmap_set_bits(maps->hsgmii_an,
+				AIROHA_PCS_HSGMII_AN_SGMII_REG_AN_0,
+				AIROHA_PCS_HSGMII_AN_SGMII_RESET_PHY |
+				AIROHA_PCS_HSGMII_AN_SGMII_AN_RESTART);
+		udelay(3);
+		regmap_clear_bits(maps->hsgmii_an,
+				  AIROHA_PCS_HSGMII_AN_SGMII_REG_AN_0,
+				  AIROHA_PCS_HSGMII_AN_SGMII_RESET_PHY |
 				  AIROHA_PCS_HSGMII_AN_SGMII_AN_RESTART);
 		break;
 	case PHY_INTERFACE_MODE_USXGMII:
@@ -984,7 +1035,7 @@
 				ck_gen_mode = AIROHA_PCS_HSGMII_PCS_FORCE_CUR_SGMII_MODE_100;
 				break;
 			case SPEED_10:
-				speed_reg = AIROHA_PCS_LINK_MODE_P0_100M;
+				speed_reg = AIROHA_PCS_LINK_MODE_P0_10M;
 				if_mode = AIROHA_PCS_HSGMII_AN_SPEED_FORCE_MODE_10;
 				ck_gen_mode = AIROHA_PCS_HSGMII_PCS_FORCE_CUR_SGMII_MODE_10;
 				break;
@@ -1054,6 +1105,8 @@
 		recovery->config_pending = true;
 		mutex_unlock(&recovery->lock);
 	}
+
+	port->initialized = false;
 
 	/* Select HSGMII or USXGMII in SCU regs */
 	airoha_pcs_setup_scu(priv, port->index, interface);
--- a/drivers/net/pcs/airoha/pcs-airoha.h
+++ b/drivers/net/pcs/airoha/pcs-airoha.h
@@ -1720,6 +1720,8 @@
 	struct airoha_pcs_priv *priv;
 	int index;
 	phy_interface_t interface;
+	unsigned int neg_mode;
+	bool initialized;
 	struct airoha_pcs_rxlock_recovery rxlock;
 
 	struct phylink_pcs pcs;
