+static int airoha_npu_restart_core(struct airoha_npu *npu, int core)
+{
+	int i, err = 0;
+	u32 val;
+
+	if (core < 0 || core >= ARRAY_SIZE(npu->cores))
+		return -EINVAL;
+
+	mutex_lock(&npu->recovery_lock);
+	if (atomic_read_acquire(&npu->stopped)) {
+		err = -ESHUTDOWN;
+		goto unlock;
+	}
+
+	atomic_set_release(&npu->recovering, 1);
+
+	/* Drain mailbox requests which passed the recovery check. */
+	for (i = 0; i < ARRAY_SIZE(npu->cores); i++) {
+		spin_lock_bh(&npu->cores[i].lock);
+		spin_unlock_bh(&npu->cores[i].lock);
+	}
+	if (!core) {
+		spin_lock_bh(&npu->cores[0].lock);
+		npu->cores[0].mbox_blocked = true;
+		spin_unlock_bh(&npu->cores[0].lock);
+	}
+
+	err = regmap_read(npu->regmap, REG_CR_BOOT_CONFIG, &val);
+	if (err)
+		goto out;
+
+	val = (val & GENMASK(7, 0)) | BIT(8 + core);
+	/* The SDK reboot restarts execution, but does not establish a DMA
+	 * fence. Keep poisoned slots quarantined across software recovery.
+	 */
+	for (i = 0; i < 2; i++) {
+		err = regmap_write(npu->regmap, REG_CR_BOOT_CONFIG, val);
+		if (!err && !core)
+			err = regmap_write(npu->regmap, REG_CR_NPU_MIB(0),
+					   U32_MAX);
+		if (!err)
+			err = regmap_write(npu->regmap, REG_CR_BOOT_TRIGGER, 2);
+		if (err)
+			break;
+
+		msleep(100);
+	}
+	if (!err && !core) {
+		err = airoha_npu_mbox_health_check(npu);
+	}
+
+out:
+	if (!core) {
+		spin_lock_bh(&npu->cores[0].lock);
+		npu->cores[0].mbox_blocked = !!err;
+		spin_unlock_bh(&npu->cores[0].lock);
+	}
+	npu->recovery_err = err;
+	atomic_set_release(&npu->recovering, 0);
+unlock:
+	mutex_unlock(&npu->recovery_lock);
+
+	return err;
+}
+
+int airoha_npu_recover(struct airoha_npu *npu)
+{
+	return airoha_npu_restart_core(npu, 0);
+}
+EXPORT_SYMBOL_GPL(airoha_npu_recover);
+
+int airoha_npu_recover_mailbox(struct airoha_npu *npu)
+{
+	struct airoha_npu_core *core = &npu->cores[0];
+	int err;
+
+	mutex_lock(&npu->recovery_lock);
+	if (atomic_read_acquire(&npu->stopped)) {
+		err = -ESHUTDOWN;
+		goto unlock;
+	}
+
+	spin_lock_bh(&core->lock);
+	if (!core->mbox_blocked) {
+		err = npu->recovery_err;
+		spin_unlock_bh(&core->lock);
+		goto unlock;
+	}
+	spin_unlock_bh(&core->lock);
+
+	atomic_set_release(&npu->recovering, 1);
+	spin_lock_bh(&core->lock);
+	spin_unlock_bh(&core->lock);
+
+	/* Treat a valid fresh-slot response as a liveness and ordering barrier
+	 * for the FIFO mailbox producer. It is not a DMA fence: older poisoned
+	 * slots remain quarantined until a verified terminal reset fences DMA.
+	 */
+	err = airoha_npu_mbox_health_check(npu);
+	spin_lock_bh(&core->lock);
+	core->mbox_blocked = !!err;
+	spin_unlock_bh(&core->lock);
+
+	npu->recovery_err = err;
+	atomic_set_release(&npu->recovering, 0);
+unlock:
+	mutex_unlock(&npu->recovery_lock);
+
+	return err;
+}
+EXPORT_SYMBOL_GPL(airoha_npu_recover_mailbox);
+
+int airoha_npu_wait_recovery(struct airoha_npu *npu)
+{
+	int err;
+
+	mutex_lock(&npu->recovery_lock);
+	err = atomic_read_acquire(&npu->stopped) ? -ESHUTDOWN
+						       : npu->recovery_err;
+	mutex_unlock(&npu->recovery_lock);
+
+	return err;
+}
+EXPORT_SYMBOL_GPL(airoha_npu_wait_recovery);
+
+int airoha_npu_hard_stop(struct airoha_npu *npu)
+{
+	unsigned long flags;
+	int i, err, status;
+
+	might_sleep();
+	mutex_lock(&npu->recovery_lock);
+	if (atomic_read_acquire(&npu->hard_stopped)) {
+		err = 0;
+		goto unlock;
+	}
+	if (atomic_read_acquire(&npu->stopped))
+		goto assert_reset;
+
+	atomic_set_release(&npu->stopped, 1);
+	atomic_set_release(&npu->recovering, 1);
+	synchronize_rcu();
+	if (READ_ONCE(npu->provider_irqs_live)) {
+		devm_free_irq(npu->dev, npu->mbox_irq, npu);
+		for (i = 0; i < ARRAY_SIZE(npu->cores); i++) {
+			struct airoha_npu_core *core = &npu->cores[i];
+
+			devm_free_irq(npu->dev, core->wdt_irq, core);
+		}
+		WRITE_ONCE(npu->provider_irqs_live, false);
+	}
+	spin_lock_irqsave(&npu->io_lock, flags);
+	for (i = 0; i < ARRAY_SIZE(npu->cores); i++)
+		regmap_set_bits(npu->regmap, REG_WDT_TIMER_CTRL(i),
+				WDT_INTR_MASK);
+	for (i = 0; i < 2; i++)
+		regmap_clear_bits(npu->regmap, REG_IRQ_RXDONE(i),
+				  NPU_IRQ_RX_MASK(i));
+	regmap_write(npu->regmap, REG_IRQ_STATUS,
+		     NPU_IRQ_RX_MASK(0) | NPU_IRQ_RX_MASK(1));
+	regmap_write(npu->regmap, REG_CR_MBOX_INT_STATUS,
+		     MBOX_INT_STATUS_MASK);
+	regmap_update_bits(npu->regmap, REG_CR_MBQ8_CTRL(3),
+			   MBOX_MSG_STATUS | MBOX_MSG_DONE, MBOX_MSG_DONE);
+	spin_unlock_irqrestore(&npu->io_lock, flags);
+
+	for (i = 0; i < ARRAY_SIZE(npu->cores); i++) {
+		spin_lock_bh(&npu->cores[i].lock);
+		npu->cores[i].mbox_blocked = true;
+		spin_unlock_bh(&npu->cores[i].lock);
+	}
+
+assert_reset:
+	/* An asserted top-level NPU reset is the terminal DMA fence. */
+	err = reset_control_assert(npu->rst);
+	status = reset_control_status(npu->rst);
+	if (status < 0) {
+		if (!err)
+			err = status;
+	} else if (!status) {
+		if (!err)
+			err = -EIO;
+	} else {
+		atomic_set_release(&npu->hard_stopped, 1);
+		err = 0;
+	}
+
+	npu->recovery_err = -ESHUTDOWN;
+unlock:
+	mutex_unlock(&npu->recovery_lock);
+
+	return err;
+}
+EXPORT_SYMBOL_GPL(airoha_npu_hard_stop);
 
