+					  GLOBAL_CFG_TX_DMA_EN_MASK |
+					  GLOBAL_CFG_RX_DMA_EN_MASK);
+
+		for (i = 0; i < ARRAY_SIZE(eth->qdma); i++) {
+			err = read_poll_timeout(airoha_qdma_rr, status,
+						!(status &
+						  (GLOBAL_CFG_TX_DMA_BUSY_MASK |
+						   GLOBAL_CFG_RX_DMA_BUSY_MASK)),
+						USEC_PER_MSEC, 50 * USEC_PER_MSEC,
+						true, &eth->qdma[i],
+						REG_QDMA_GLOBAL_CFG);
+			if (err)
+				dev_warn(eth->dev,
+					 "QDMA%d DMA busy, forcing reset\n", i);
+		}
+	}
+
+	err = reset_control_bulk_assert(ARRAY_SIZE(eth->rsts), eth->rsts);
+	if (err) {
+		dev_crit(eth->dev, "failed to assert Ethernet resets: %d\n",
+			 err);
+		return false;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(eth->rsts); i++) {
+		err = reset_control_status(eth->rsts[i].rstc);
+		if (err <= 0) {
+			dev_crit(eth->dev,
+				 "Ethernet reset %s is not asserted: %d\n",
+				 eth->rsts[i].id, err);
+			return false;
+		}
+	}
+
+	WRITE_ONCE(eth->qdma_dma_quiesced, true);
+	return true;
 }
 
