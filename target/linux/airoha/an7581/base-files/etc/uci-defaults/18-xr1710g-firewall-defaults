#!/bin/sh

. /lib/functions/system.sh

case "$(board_name)" in
gemtek,xr1710g-ubi)
	# XR1710G: default to software + hardware (PPE) flow offload.
	uci -q set firewall.@defaults[0].flow_offloading='1'
	uci -q set firewall.@defaults[0].flow_offloading_hw='1'
	;;
gemtek,w1700k-ubi)
	# W1700K: keep flow offload off, matching the upstream OpenWrt W1700K
	# defaults.  The PPE/flowtable offload path misbehaves on the W1700K
	# 10G ports (LuCI/SCP stall while the link stays up), so stay on the
	# plain software forwarding path until that is resolved.
	uci -q set firewall.@defaults[0].flow_offloading='0'
	uci -q set firewall.@defaults[0].flow_offloading_hw='0'
	;;
*) exit 0 ;;
esac
uci -q commit firewall

# Older images disabled firewall by leaving an OverlayFS whiteout over the
# ROM startup link. Remove only that whiteout before enabling the service.
firewall_whiteout=/overlay/upper/etc/rc.d/S19firewall
if [ -c "$firewall_whiteout" ]; then
	rm -f "$firewall_whiteout"
fi

if [ -x /etc/init.d/firewall ]; then
	/etc/init.d/firewall enable
	/etc/init.d/firewall restart
fi

exit 0
